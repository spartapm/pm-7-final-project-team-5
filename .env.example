# Vercel Environment Variables에도 같은 이름으로 넣습니다.
# NEXT_PUBLIC_ 값은 빌드 시 클라이언트에 들어가므로, 시크릿/서비스롤은 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 카카오 로그인 (REST API). Redirect URI는 카카오 콘솔에 등록해야 실제 OAuth가 됩니다.
NEXT_PUBLIC_KAKAO_REST_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3005/auth/kakao/callback
KAKAO_CLIENT_SECRET=

# 인사이트 문장 생성. 없으면 템플릿 문장을 씁니다.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 테이블 생성(npm run db:schema)할 때만 필요. 앱 런타임에는 쓰지 않습니다.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
